# ScamCheck Backend Environment Configuration Example

SCAMCHECK_ENV=development
SCAMCHECK_DEBUG=false
SCAMCHECK_HOST=0.0.0.0
SCAMCHECK_PORT=8000
SCAMCHECK_LOG_LEVEL=INFO

# SQLite Persistence Path
SCAMCHECK_DB_PATH=scamcheck.db
SCAMCHECK_ENABLE_PERSISTENCE=true

# Intelligence Providers ('offline', 'network', 'mock')
SCAMCHECK_DOMAIN_PROVIDER=offline
SCAMCHECK_SEMANTIC_PROVIDER=deterministic

# Security & CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

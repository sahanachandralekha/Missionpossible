# ScamCheck Root Environment Configuration Example
# Copy this file to .env for local runtime configuration.

# Application Settings
SCAMCHECK_ENV=development
SCAMCHECK_DEBUG=false
SCAMCHECK_LOG_LEVEL=INFO

# Backend API Configuration
SCAMCHECK_HOST=0.0.0.0
SCAMCHECK_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# Persistence & Storage
SCAMCHECK_DB_PATH=scamcheck.db
SCAMCHECK_ENABLE_PERSISTENCE=true

# Intelligence & Provider Modes
SCAMCHECK_DOMAIN_PROVIDER=offline
SCAMCHECK_SEMANTIC_PROVIDER=deterministic

# Security & CORS (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
